# Canonical API origin. Match the API `PORT` from its `.env.example` (default 3000).
# If you remapped the API port locally, change this value to match.
VITE_API_BASE_URL=http://localhost:3000
# OpenAPI document URL used by `npm run api:generate` (default: ${VITE_API_BASE_URL}/api/docs-json).
API_OPENAPI_URL=http://localhost:3000/api/docs
