# Canonical API origin. Required for production builds. Match the API `PORT`
# from its `.env.example` (default 3000). If you remapped the API port locally, change this value to match.
VITE_API_BASE_URL=http://localhost:3000
# Hosted shared demo (Cloudflare Pages). Shows the read-only banner; pair with API
# DEMO_READ_ONLY=true. Public boolean only - never put reset tokens here.
# VITE_DEMO_MODE=true
# OpenAPI document URL used by `npm run api:generate` (default: ${VITE_API_BASE_URL}/api/docs-json).
API_OPENAPI_URL=http://localhost:3000/api/docs
