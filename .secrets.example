# Local demo seed credentials for Playwright (not production).
# Same values as the API seed / docs/development/SEEDING.md.
# Generate local file: npm run env:init:secrets
# Overwrite existing: npm run env:init:secrets:force
# Do not commit .secrets (gitignored). CI uses GitHub repository secrets instead.
#
# Playwright loads .secrets automatically (see playwright.config.ts).

# Required in CI: Playwright fails if unset
E2E_ADMIN_EMAIL=admin@store.local
E2E_ADMIN_PASSWORD=Admin123!

# Required in CI: operator-gate spec
E2E_CUSTOMER_EMAIL=customer@store.local
E2E_CUSTOMER_PASSWORD=Customer123!

# Required in CI: roles + change-password. Email defaults to superadmin@store.local if unset.
E2E_SUPERADMIN_EMAIL=superadmin@store.local
E2E_SUPERADMIN_PASSWORD=SuperAdmin123!
