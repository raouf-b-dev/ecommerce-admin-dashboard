{
  "name": "ecommerce-admin-dashboard",
  "private": true,
  "version": "0.8.0",
  "license": "MIT",
  "author": "Abderaouf Bouzerara <https://github.com/raouf-b-dev>",
  "description": "Admin SPA for the E-commerce Store API.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "lint": "eslint . --cache && node scripts/lint-ascii-prose.cjs",
    "lint:fix": "eslint . --cache --fix && node scripts/lint-ascii-prose.cjs --fix",
    "lint:prune": "eslint . --cache --prune-suppressions",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run playwright:install",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "verify": "node scripts/verify.mjs",
    "check:agent": "node scripts/agent-check.mjs",
    "api:generate": "node ./scripts/generate-api-client.js",
    "env:init": "node ./scripts/generate-env.js",
    "env:init:force": "node ./scripts/generate-env.js --overwrite",
    "env:init:secrets": "node ./scripts/generate-env.js --secrets-only",
    "env:init:secrets:force": "node ./scripts/generate-env.js --secrets-only --overwrite",
    "assets:stills": "node ./scripts/capture-showcase.js",
    "assets:walkthrough": "node ./scripts/create-walkthrough.js",
    "assets:capture": "npm run assets:stills && npm run assets:walkthrough"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raouf-b-dev/ecommerce-admin-dashboard.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.6.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "error"
    }
  },
  "bugs": {
    "url": "https://github.com/raouf-b-dev/ecommerce-admin-dashboard/issues"
  },
  "homepage": "https://github.com/raouf-b-dev/ecommerce-admin-dashboard#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.0",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.152.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "msw": true
  }
}
